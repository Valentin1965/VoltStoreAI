# ============================================================
# GREEN LIGHT SCANDINAVIA — Environment Variables
# ============================================================
# ⚠️  ЦЕЙ ФАЙЛ ТІЛЬКИ ДЛЯ ЛОКАЛЬНОЇ РОЗРОБКИ
# ⚠️  НІКОЛИ не комітити реальні ключі до git!
# ⚠️  Файл захищений .gitignore
#
# Для production:
#   Vercel  → Project Settings → Environment Variables
#   Netlify → Site Settings → Environment Variables
#   GitHub  → Settings → Secrets and variables → Actions
# ============================================================

# ----------------------------------------------------------
# FRONTEND (Vite) — доступні в браузері через import.meta.env
# Тільки ПУБЛІЧНІ ключі! (anon/public, не service_role/secret)
# ----------------------------------------------------------

# Supabase (публічний anon ключ — безпечно у браузері)
# У Vercel обов'язково додайте ОБА значення для Production і зробіть Redeploy — Vite підставляє їх на етапі build.
# Якщо в браузері помилка «не знайдено ключа API» — зазвичай немає VITE_SUPABASE_ANON_KEY у змінних оточення деплою.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Обовʼязковий TOTP (2FA) у кабінеті/кошику працює лише для входу через Supabase Auth (`signInWithPassword`).
# У Supabase Dashboard: Authentication → Multi-factor → увімкніть Authenticator / TOTP.
# Якщо клієнт у БД `clients`, але немає користувача в `auth.users`, додаток може входити через RPC `login_client_with_password` — тоді 2FA немає.
# Щоб заборонити цей шлях у production:
# VITE_DISABLE_LEGACY_PASSWORD_LOGIN=true

# Gemini AI (для LiveAssistant / калькулятора)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_API_KEY=your_gemini_api_key_here

# App info
VITE_APP_NAME=Green Light Scandinavia
VITE_APP_VERSION=1.0.5
# Canonical origin for meta/OG/JSON-LD (match production hostname, e.g. https://www.glsolargroup.dk)
# VITE_SITE_URL=https://www.glsolargroup.dk

# Marketing email funnel (optional). When not "true", sendFunnelEmail() is a no-op.
# Deploy: supabase functions deploy send-funnel-email (same RESEND_* secrets as send-email)
# VITE_EMAIL_FUNNEL_ENABLED=true

# ----------------------------------------------------------
# BACKEND / SERVERLESS API (api/*.ts)
# Секретні ключі — тільки на сервері, ніколи в браузері
# ----------------------------------------------------------

# Supabase — URL для серверних функцій (якщо не задано, частина коду читає VITE_SUPABASE_URL)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase service role (адмін-доступ до БД; обов'язково для api/admin/* та create-payment)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Mollie (платежі) + базовий URL сайту (redirect/webhook після оплати)
SITE_URL=https://www.glsolargroup.dk
MOLLIE_API_KEY=test_your_mollie_api_key_here

# Resend (транзакційні email) — для Vercel api/webhook.ts (якщо використовуєте)
RESEND_API_KEY=re_your_resend_api_key_here
#
# ⚠️ Листи з каталогу йдуть через Supabase Edge send-email — ключ має бути в SUPABASE:
#   supabase secrets set RESEND_API_KEY=re_...
#   supabase functions deploy send-email
# Швидка перевірка (після deploy): у DevTools → Network подивіться POST send-email
# або тимчасово викличте з коду: invoke з body { type: '_health' } → resendKeyConfigured: true

# Admin panel password (set in Vercel — VITE_ADMIN_PASSWORD)
VITE_ADMIN_PASSWORD=your_admin_password_here

# Admin JWT (генеруй: openssl rand -hex 32)
ADMIN_PASSWORD=change_me_to_strong_password
ADMIN_JWT_SECRET=generate_with_openssl_rand_hex_32

# ----------------------------------------------------------
# VITE DEV — proxy /api (defaults to https://www.glsolargroup.dk in development)
# ----------------------------------------------------------
# Override target (preview / other domain):
# DEV_API_PROXY=https://your-deployment.vercel.app
# Turn off proxy entirely:
# DEV_API_PROXY_DISABLE=true

# Optional: if the SPA is served from a host that has NO /api (static CDN), set the Vercel origin
# so checkout still calls Mollie. Build-time variable (set in Vercel → Env for Production).
# VITE_PAYMENT_API_BASE=https://www.glsolargroup.dk

# ----------------------------------------------------------
# ЗАГАЛЬНЕ
# ----------------------------------------------------------
NODE_ENV=development
DISABLE_REACT_DEVTOOLS=true

